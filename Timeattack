local playerCar = ac.getCar(0)

-- Связь с HUD дуэлей (скрывает скрипт во время баттла)
local battleSync = ac.connect({
    ac.StructItem.key("txr_battle_state"),
    isActive = ac.StructItem.boolean()
}, false, ac.SharedNamespace.Shared)

-- === КОНФИГУРАЦИЯ СЕКТОРОВ (TIME ATTACK) ===
local sectors = {
    {
        name = "RACEPORT Route",
        startPos = vec3(6091.9, 32.2, -4998.5),   -- Точка старта
        finishPos = vec3(4022.8, 17.7, -8586.2),  -- Точка финиша
        gateRadius = 25.0,                        -- Радиус ворот старта и финиша (25 м)
        bestTime = nil
    }
}

-- Состояние таймера
local activeSectorIdx = nil
local currentTime = 0.0
local lastTime = nil
local lastDelta = nil
local isNewRecord = false

-- Уведомления
local statusText = ""
local statusColor = rgbm(1, 1, 1, 1)
local statusTimer = 0.0

local function formatTime(sec)
    if not sec then return "--'--\"---" end
    local mins = math.floor(sec / 60)
    local secs = math.floor(sec % 60)
    local millis = math.floor((sec * 1000) % 1000)
    return string.format("%02d'%02d\"%03d", mins, secs, millis)
end

local function formatDelta(diff)
    if not diff then return "" end
    local sign = diff > 0 and "+" or "-"
    return string.format("%s%.3fs", sign, math.abs(diff))
end

local function showBanner(text, color, duration)
    statusText = text
    statusColor = color
    statusTimer = duration or 3.5
end

function script.update(dt)
    -- Если активен баттл — сбрасываем текущую попытку и скрываем HUD
    if battleSync and battleSync.isActive then
        activeSectorIdx = nil
        currentTime = 0.0
        statusTimer = 0.0
        return
    end

    if statusTimer > 0 then
        statusTimer = statusTimer - dt
    end

    if not playerCar then return end

    local pos = playerCar.position
    local speed = playerCar.speedKmh or 0

    -- 1. Проверка пересечения линии СТАРТА
    if not activeSectorIdx then
        for i, sec in ipairs(sectors) do
            if pos:distance(sec.startPos) <= sec.gateRadius and speed > 20.0 then
                activeSectorIdx = i
                currentTime = 0.0
                showBanner("СТАРТ! ВРЕМЯ ПОШЛО", rgbm(1.0, 0.65, 0.35, 1), 3.0)
                break
            end
        end
    else
        -- 2. Идет замер времени (без сброса при аварии)
        local sec = sectors[activeSectorIdx]
        currentTime = currentTime + dt

        -- 3. Проверка пересечения линии ФИНИША
        if pos:distance(sec.finishPos) <= sec.gateRadius then
            lastTime = currentTime

            if not sec.bestTime then
                sec.bestTime = currentTime
                lastDelta = 0.0
                isNewRecord = true
                showBanner(string.format("ФИНИШ! ВРЕМЯ: %s", formatTime(lastTime)), rgbm(1.0, 0.65, 0.35, 1), 4.5)
            elseif currentTime < sec.bestTime then
                lastDelta = currentTime - sec.bestTime -- отрицательная дельта (улучшение)
                sec.bestTime = currentTime
                isNewRecord = true
                showBanner(string.format("НОВЫЙ РЕКОРД! %s (%s)", formatTime(lastTime), formatDelta(lastDelta)), rgbm(0.3, 1.0, 0.45, 1), 5.0)
            else
                lastDelta = currentTime - sec.bestTime -- положительная дельта (хуже лучшего)
                isNewRecord = false
                showBanner(string.format("ФИНИШ! %s (%s)", formatTime(lastTime), formatDelta(lastDelta)), rgbm(1.0, 1.0, 1.0, 1), 4.5)
            end

            activeSectorIdx = nil
        end
    end
end

function script.drawUI()
    -- Полностью скрываем HUD во время дуэли
    if (battleSync and battleSync.isActive) or not playerCar then
        return
    end

    local screenSize = ac.getUI().windowSize
    local scaleY = screenSize.y / 1440.0
    local displaySec = activeSectorIdx and sectors[activeSectorIdx] or sectors[1]

    local distToStart = playerCar.position:distance(displaySec.startPos)
    local distToFinish = playerCar.position:distance(displaySec.finishPos)

    -- Отображаем HUD:
    -- 1) во время активного заезда
    -- 2) если уже был завершен хотя бы один заезд (lastTime ~= nil)
    -- 3) если до старта <= 400 метров
    if not activeSectorIdx and not lastTime and distToStart > 400.0 then
        return
    end

    -- Позиция: сверху справа
    local boxW = math.floor(340 * math.max(0.85, scaleY))
    local boxH = math.floor(82 * math.max(0.85, scaleY))
    local margin = math.floor(30 * math.max(0.85, scaleY))
    local x1 = screenSize.x - boxW - margin
    local y1 = margin

    -- Полупрозрачный фон (альфа 0.45)
    ui.drawRectFilled(vec2(x1, y1), vec2(x1 + boxW, y1 + boxH), rgbm(0.05, 0.05, 0.07, 0.45), 3)
    local borderColor = activeSectorIdx and rgbm(1.0, 0.65, 0.35, 0.9) or rgbm(1.0, 1.0, 1.0, 0.35)
    ui.drawRect(vec2(x1, y1), vec2(x1 + boxW, y1 + boxH), borderColor, 3, 1.5)

    -- Верхняя строка: Название маршрута и дельта (если заезд завершен)
    ui.setCursor(vec2(x1 + 14, y1 + 8))
    ui.textColored(displaySec.name, rgbm(0.85, 0.85, 0.88, 0.95))

    if not activeSectorIdx and lastDelta ~= nil then
        local deltaStr = formatDelta(lastDelta)
        local deltaColor = (lastDelta <= 0) and rgbm(0.3, 1.0, 0.45, 1) or rgbm(1.0, 0.35, 0.35, 1)
        if lastDelta == 0 and isNewRecord then
            deltaStr = "FIRST RUN"
            deltaColor = rgbm(1.0, 0.65, 0.35, 1)
        end
        local dSize = ui.measureText(deltaStr)
        ui.setCursor(vec2(x1 + boxW - dSize.x - 14, y1 + 8))
        ui.textColored(deltaStr, deltaColor)
    end

    -- Средняя строка: Текущее время / Последний заезд / Дистанция до старта
    ui.setCursor(vec2(x1 + 14, y1 + 32))
    if activeSectorIdx then
        ui.textColored("TIME: " .. formatTime(currentTime), rgbm(1.0, 1.0, 1.0, 1))
    elseif lastTime then
        ui.textColored("LAST: " .. formatTime(lastTime), rgbm(1.0, 1.0, 1.0, 1))
    else
        ui.textColored(string.format("ДО СТАРТА: %.0f м", distToStart), rgbm(0.9, 0.9, 0.9, 0.95))
    end

    -- Нижняя строка: Лучшее время за сессию (BEST) и дистанция до финиша во время заезда
    ui.setCursor(vec2(x1 + 14, y1 + 54))
    ui.textColored("BEST: " .. formatTime(displaySec.bestTime), rgbm(1.0, 0.65, 0.35, 0.95))

    if activeSectorIdx then
        local finStr = string.format("ФИНИШ: %.0f м", distToFinish)
        local finSize = ui.measureText(finStr)
        ui.setCursor(vec2(x1 + boxW - finSize.x - 14, y1 + 54))
        ui.textColored(finStr, rgbm(0.8, 0.8, 0.85, 0.9))
    end

    -- Всплывающий баннер старта / финиша
    if statusTimer > 0 and statusText ~= "" then
        local stH = math.floor(28 * math.max(0.85, scaleY))
        local stY = y1 + boxH + 6
        ui.drawRectFilled(vec2(x1, stY), vec2(x1 + boxW, stY + stH), rgbm(0.05, 0.05, 0.07, 0.55), 3)
        ui.drawRect(vec2(x1, stY), vec2(x1 + boxW, stY + stH), statusColor, 3, 1.2)

        local stSize = ui.measureText(statusText)
        ui.setCursor(vec2(x1 + (boxW - stSize.x) * 0.5, stY + (stH - stSize.y) * 0.5))
        ui.textColored(statusText, statusColor)
    end
end
