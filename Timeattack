local playerCar = ac.getCar(0)

-- === НАСТРОЙКИ СЕКТОРА (ЗАМЕНИ НА СВОИ КООРДИНАТЫ С ТРАССЫ) ===
local sectorName = "C1 INNER TIME ATTACK"
local startPos = vec3(-1890.0, 12.5, -1540.2)   -- Координаты точки старта (X, Y, Z)
local finishPos = vec3(-1425.5, 18.2, -3104.8)  -- Координаты точки финиша (X, Y, Z)
local gateRadius = 18.0                         -- Ширина створа ворот старта и финиша (в метрах)
local cancelOnCrash = true                      -- Сбрасывать ли попытку при сильной аварии

-- Состояние таймера
local isTiming = false
local currentTime = 0.0
local bestTime = nil
local lastTime = nil
local lastDiff = nil

-- Уведомления
local statusText = ""
local statusColor = rgbm(1, 1, 1, 1)
local statusTimer = 0.0

local function formatTime(sec)
    if not sec then return "--'--\"---" end
    local mins = math.floor(sec / 60)
    local secs = math.floor(sec % 60)
    local millis = math.floor((sec * 1000) % 1000)
    return string.format("%02d'%02d\"%03d", mins, secs, millis)
end

local function showBanner(text, color, duration)
    statusText = text
    statusColor = color
    statusTimer = duration or 3.5
end

function script.update(dt)
    if statusTimer > 0 then
        statusTimer = statusTimer - dt
    end

    if not playerCar then return end

    local pos = playerCar.position
    local speed = playerCar.speedKmh or 0

    -- 1. Проверка пересечения линии СТАРТА
    local distToStart = pos:distance(startPos)
    if distToStart <= gateRadius and speed > 30.0 then
        if not isTiming then
            isTiming = true
            currentTime = 0.0
            showBanner("СТАРТ СЕКТОРА! ВРЕМЯ ПОШЛО", rgbm(1.0, 0.65, 0.35, 1), 2.5)
        end
    end

    -- 2. Если идет замер времени
    if isTiming then
        currentTime = currentTime + dt

        -- Проверка на аварию (если включено)
        if cancelOnCrash then
            local hitOtherCar = playerCar.collidedWith and playerCar.collidedWith > 0
            local hardWallHit = playerCar.acceleration and (math.abs(playerCar.acceleration.x) > 4.0 or math.abs(playerCar.acceleration.z) > 4.0)
            if hitOtherCar or hardWallHit then
                isTiming = false
                currentTime = 0.0
                showBanner("ПОПЫТКА ПРЕРВАНА: АВАРИЯ", rgbm(1.0, 0.25, 0.2, 1), 3.0)
                return
            end
        end

        -- 3. Проверка пересечения линии ФИНИША
        local distToFinish = pos:distance(finishPos)
        if distToFinish <= gateRadius then
            isTiming = false
            lastTime = currentTime

            if not bestTime or currentTime < bestTime then
                lastDiff = bestTime and (currentTime - bestTime) or nil
                bestTime = currentTime
                showBanner(string.format("НОВЫЙ РЕКОРД СЕКТОРА: %s!", formatTime(bestTime)), rgbm(1.0, 0.65, 0.35, 1), 5.0)
            else
                lastDiff = currentTime - bestTime
                showBanner(string.format("ФИНИШ: %s (+%.3f с)", formatTime(lastTime), lastDiff), rgbm(1.0, 1.0, 1.0, 1), 4.5)
            end
        end
    end
end

function script.drawUI()
    local screenSize = ac.getUI().windowSize

    -- Показываем HUD только во время проезда сектора, при уведомлении или если уже есть рекорд
    if not isTiming and statusTimer <= 0 and not bestTime then
        return
    end

    -- Позиция: левее центра или под очками шашек (адаптировано под 3440x1440)
    local scaleY = screenSize.y / 1440.0
    local boxW = math.floor(300 * math.max(0.85, scaleY))
    local boxH = math.floor(74 * math.max(0.85, scaleY))

    -- Размещаем слева от центрального HUD обгонов, чтобы блоки не перекрывали друг друга
    local x1 = (screenSize.x * 0.5) - boxW - math.floor(190 * math.max(0.85, scaleY))
    local y1 = math.floor(115 * scaleY)

    -- Полупрозрачный фон (альфа 0.45)
    ui.drawRectFilled(vec2(x1, y1), vec2(x1 + boxW, y1 + boxH), rgbm(0.05, 0.05, 0.07, 0.45), 3)
    local borderColor = isTiming and rgbm(1.0, 0.65, 0.35, 0.9) or rgbm(1.0, 1.0, 1.0, 0.35)
    ui.drawRect(vec2(x1, y1), vec2(x1 + boxW, y1 + boxH), borderColor, 3, 1.5)

    -- Название сектора
    ui.setCursor(vec2(x1 + 14, y1 + 8))
    ui.textColored(sectorName, rgbm(0.85, 0.85, 0.88, 0.95))

    -- Текущее или последнее время
    local displayTime = isTiming and formatTime(currentTime) or formatTime(lastTime)
    ui.setCursor(vec2(x1 + 14, y1 + 34))
    ui.textColored("TIME: " .. displayTime, rgbm(1.0, 1.0, 1.0, 1))

    -- Лучшее время (BEST)
    local bestStr = "BEST: " .. formatTime(bestTime)
    local bestSize = ui.measureText(bestStr)
    ui.setCursor(vec2(x1 + boxW - bestSize.x - 14, y1 + 34))
    ui.textColored(bestStr, rgbm(1.0, 0.65, 0.35, 0.95))

    -- Всплывающий баннер старта / финиша
    if statusTimer > 0 and statusText ~= "" then
        local stH = math.floor(28 * math.max(0.85, scaleY))
        local stY = y1 + boxH + 6
        ui.drawRectFilled(vec2(x1, stY), vec2(x1 + boxW, stY + stH), rgbm(0.05, 0.05, 0.07, 0.55), 3)
        ui.drawRect(vec2(x1, stY), vec2(x1 + boxW, stY + stH), statusColor, 3, 1.2)

        local stSize = ui.measureText(statusText)
        ui.setCursor(vec2(x1 + (boxW - stSize.x) * 0.5, stY + (stH - stSize.y) * 0.5))
        ui.textColored(statusText, statusColor)
    end
end

